{
  "cli": {
    "version": ">= 10.2.2"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://infohub.net.cn/api"
      }
    },
    "testflight": {
      "ios": {
        "buildType": "release",
        "distribution": "app-store"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://infohub.net.cn/api"
      }
    },
    "production": {
      "ios": {
        "buildType": "release",
        "distribution": "app-store"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://infohub.net.cn/api"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "appleId": "zxchengb@163.com",
        "ascAppId": "6739748229"
      }
    },
    "production": {
      "ios": {
        "appleId": "zxchengb@163.com",
        "ascAppId": "6739748229"
      }
    }
  }
}