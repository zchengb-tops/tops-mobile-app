{
  "name": "InfoHub",
  "version": "1.0.1",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "setenv:local": "node setenv.js local",
    "setenv:production": "node setenv.js production",
    "ios:local": "npm run setenv:local && expo run:ios --device",
    "ios:prod": "npm run setenv:production && expo run:ios --device",
    "android:local": "npm run setenv:local && expo run:android --device",
    "android:prod": "npm run setenv:production && expo run:android --device",
    "build-test:ios": "eas build --profile preview --platform ios",
    "build-testflight:ios": "eas build --platform ios --profile testflight --auto-submit && git add . && git commit -m 'feat: update ios build number.'",
    "build-prod:android": "eas build --platform android --profile production",
    "ios": "expo run:ios",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/slider": "4.5.5",
    "@react-native-firebase/analytics": "^21.6.1",
    "@react-native-firebase/app": "^21.6.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@rneui/base": "^4.0.0-rc.7",
    "@rneui/themed": "^4.0.0-rc.8",
    "@shopify/react-native-skia": "1.5.0",
    "@wuba/react-native-echarts": "^1.3.1",
    "burnt": "^0.12.2",
    "echarts": "^5.5.1",
    "expo": "^52.0.0",
    "expo-application": "~6.0.2",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.20",
    "expo-linear-gradient": "~14.0.2",
    "expo-modules-core": "~2.2.3",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-circular-progress": "^1.4.0",
    "react-native-draggable-flatlist": "^4.0.1",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-haptic-feedback": "^2.3.1",
    "react-native-mmkv": "^2.12.2",
    "react-native-modal": "^13.0.1",
    "react-native-pager-view": "6.5.1",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-share": "^11.0.3",
    "react-native-svg": "15.8.0",
    "react-native-system-navigation-bar": "^2.6.4",
    "react-native-tab-view": "^3.5.2",
    "react-native-track-player": "^4.1.1",
    "react-native-webview": "13.12.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/cli": "^0.18.29",
    "@react-native-community/cli": "^20.0.2",
    "patch-package": "^8.0.0",
    "react-native-svg-transformer": "^1.5.0"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": true
      }
    }
  }
}
