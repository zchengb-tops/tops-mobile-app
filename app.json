{
  "expo": {
    "name": "InfoHub",
    "slug": "tops",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/welcomePage.png",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cn.zchengb.infohub",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "cn.zchengb.infohub"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "641d3952-0de1-4a28-afa6-6a0a2b2b3a74"
      }
    },
    "owner": "zxchengb",
    "plugins": [
      "expo-build-properties"
    ]
  }
}
